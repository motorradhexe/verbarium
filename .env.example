# Verbarium — environment configuration
#
# Copy this file to `.env` and adjust as needed:
#   cp .env.example .env
#
# Every value has a sensible default, so the stack starts even without a
# `.env` file. Backend settings use the `VERBARIUM_` prefix.

# --- Application ------------------------------------------------------------

# development | production
VERBARIUM_ENVIRONMENT=development

# critical | error | warning | info | debug
VERBARIUM_LOG_LEVEL=info

# Comma-separated list of origins allowed to call the API from a browser.
VERBARIUM_CORS_ORIGINS=http://localhost:5173

# Path prefix for all API routes. /health stays at the root regardless.
VERBARIUM_API_PREFIX=/api

# --- Ports (host side) ------------------------------------------------------

VERBARIUM_BACKEND_PORT=8000
VERBARIUM_FRONTEND_PORT=5173

# --- Database ---------------------------------------------------------------

# sqlite   — default, single-user and development setups
# postgres — recommended for team deployments; start the stack with
#            `docker compose --profile postgres up`
VERBARIUM_DB_BACKEND=sqlite

# Full SQLAlchemy URL. When set, it overrides every setting below — use it for
# managed databases or non-standard connection options.
# Examples:
#   sqlite+pysqlite:///./data/verbarium.db
#   postgresql+psycopg://user:password@host:5432/verbarium
# VERBARIUM_DATABASE_URL=

# SQLite only: path to the database file (relative to the backend directory).
VERBARIUM_SQLITE_PATH=./data/verbarium.db

# PostgreSQL only. Inside Docker Compose the host is the service name `db`;
# for a database outside Compose use its hostname instead.
VERBARIUM_POSTGRES_HOST=db
VERBARIUM_POSTGRES_PORT=5432
VERBARIUM_POSTGRES_USER=verbarium
VERBARIUM_POSTGRES_PASSWORD=verbarium
VERBARIUM_POSTGRES_DB=verbarium

# --- Frontend ---------------------------------------------------------------

# Set to true when bind-mounted file changes do not trigger a reload
# (common on macOS and Windows).
VITE_USE_POLLING=false

# --- AI providers (BYOK) ----------------------------------------------------
#
# Not used yet. AI keys will be configured per workspace in the UI and stored
# encrypted in the database — not through environment variables.
